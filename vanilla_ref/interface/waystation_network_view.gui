guiTypes = {
	containerWindowType = { #waystation_network_view
		name = "waystation_network_view"
		position = { x = 800 y = 100 }
		size = { width = 540 height = 632 }
		moveable = yes
		clipping = no

		backGround = {
			name = "background"
			quadTextureSprite ="GFX_waystation_network_bg"
		}

		# Header
		buttonType = {
			name = "rename_button"
			text = "";
			quadTextureSprite = "gfx_transparency_button"
			position = { x = 10 y = 10 }
			# size set by code to match name
			oversound = no_sound
		}

		instantTextBoxType = {
			name = "name"
			font = "malgun_goth_24"
			text = ""
			position = { x = 10 y = 10 }
			maxWidth = 500
			maxHeight = 40
			fixedSize = yes
			format = left
			alwaysTransparent = yes
		}

		# Header Buttons
		containerWindowType = {
			name = "header_actions"
			position = { x = 385 y = 6 }
			size = { width = 135 height = 40 }

			buttonType = {
				name = "previous_extra_shortcut"
				quadTextureSprite = "gfx_transparency_button"
				orientation = UPPER_RIGHT
				position = { x = -119 y = 0 }
				shortcut = "SHIFT+TAB"
				clicksound = "click"
			}

			buttonType = {
				name = "previous"
				quadTextureSprite = "GFX_button_left_solid"
				orientation = UPPER_RIGHT
				position = { x = -119 y = 0 }
				shortcut = "CTRL+TAB"
				clicksound = "click"
				pdx_tooltip = "PREV"
			}

			buttonType = {
				name = "next"
				quadTextureSprite = "GFX_button_right_solid"
				orientation = UPPER_RIGHT
				position = { x = -84 y = 0 }
				shortcut = "TAB"
				clicksound = "click"
				pdx_tooltip = "NEXT"
			}

			buttonType = {
				name = "close"
				quadTextureSprite = "GFX_close_solid"
				orientation = UPPER_RIGHT
				position = { x = -34 y = 0 }
				shortcut = "ESCAPE"
				clicksound = "back_click"
				actionShortcut = "cancel"
				pdx_tooltip = "CLOSE_TITLE"
			}
		}

		containerWindowType = {
			name = "content"
			position = { x = 10 y = 50 }
			size = { width = 520 height = 572 }

			background = {
				name = "background"
				quadTextureSprite = "GFX_dark_area"
				alwaysTransparent = yes
			}

			containerWindowType = {
				name = "modifiers_info"
				position = { x = 10 y = 10 }
				size = { width = 500 height = 166 }

				background = {
					name = "modifiers_info_background"
					quadTextureSprite = "GFX_waystation_network_background"
					alwaysTransparent = yes
				}

				containerWindowType = {
					name = "extra_background"
					position = { x = 0 y = 0 }
					size = { width = 500 height= 166 }
					clipping = yes

					#This makes the previous  background image darker. Easier to read text on top of it.
					background = {
						name = "extra_background_background"
						spriteType = "GFX_species_tiles_dark_area"
					}

					#Moving stripes
					iconType = {
						name = "extra_background_stripes"
						spriteType = "GFX_waystation_network_background_stripes"
					}
				}

				instantTextBoxType = {
					name = "modifiers_info_label"
					font = "malgun_goth_24"
					text_color_code = "E"
					text = "waystation_network_modifier_label"
					position = { x = 10 y = 5 }
					maxWidth = 501
					maxHeight = 20
					fixedSize = yes
					alwaysTransparent = yes
				}

				instantTextBoxType = {
					name = "modifiers_text"
					font = "cg_16b"
					position = { x = 10 y = 36 }
					maxWidth = 491
					maxHeight = 125
					scrollbartype = "standardtext_slider_small"
				}
			}

			containerWindowType = {
				name = "waystation_list_container"
				position = { x = 10 y = 186 }
				size = { width = 510 height = 427 }

				smoothListboxType = {
					name = "waystation_list_listbox"
					position = { x = 0 y = 0 }
					backGround = ""
					size = { x = 500 y = 376 }
					borderSize = { x = 0 y = 0 }
					spacing = 5
					scrollbarType = "standardlistbox_slider"
				}
			}
		}
	}

